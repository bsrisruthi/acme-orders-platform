# --- Python: bytecode, test caches, virtual environments ---
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# --- Secrets and local config: real values never go in Git ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Terraform ---
# Local provider binaries and module cache
.terraform/
# State can contain secrets in plain text
*.tfstate
*.tfstate.*
# Variable files often carry environment-specific values or secrets
*.tfvars
*.tfvars.json
# Saved plans can contain secrets too
*tfplan*
crash.log
override.tf
override.tf.json
# NOTE: .terraform.lock.hcl is deliberately NOT ignored. Commit it so every
# machine and CI run uses the same provider versions.

# --- Kubernetes credentials (kind / kubectl can export these) ---
kubeconfig
kubeconfig.*
*.kubeconfig

# --- OS / editor noise ---
.DS_Store
.idea/
.vscode/
